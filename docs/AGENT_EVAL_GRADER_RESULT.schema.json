{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-dev-automation-foundation/agent-eval-grader-result.schema.json",
  "title": "Foundation coding-agent grader result",
  "description": "Canonical identity-bound deterministic task-grader evidence. The Python parser remains authoritative for canonical bytes, sensitive-content rejection, expected identity, ordering, outcome/check agreement, and process-exit agreement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_version",
    "manifest_sha256",
    "grader_sha256",
    "foundation_sha",
    "base_sha",
    "candidate_sha",
    "outcome",
    "checks",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "task_id": {
      "$ref": "#/$defs/identity"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "grader_sha256": {
      "$ref": "#/$defs/digest"
    },
    "foundation_sha": {
      "$ref": "#/$defs/sha"
    },
    "base_sha": {
      "$ref": "#/$defs/sha"
    },
    "candidate_sha": {
      "$ref": "#/$defs/sha"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,127})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\s)[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f]$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*[\\u0000-\\u0009\\u000b-\\u001f\\u007f])[\\s\\S]+$"
    },
    "evidencePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?!/)(?![A-Za-z]:[/\\\\])(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))(?!.*[*?\\[\\]{}])(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "outcome",
        "message",
        "evidence_paths"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/identity"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "message": {
          "$ref": "#/$defs/singleLine"
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidencePath"
          }
        }
      }
    }
  }
}
