{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-dev-automation-foundation/agent-eval-suite.schema.json",
  "title": "Foundation coding-agent evaluation suite catalog",
  "description": "A canonical inventory of immutable task manifests and checked-in fixture/grader directory roots. scripts/agent_eval_suite_contract.py is authoritative for canonical bytes, ordering, local filesystem safety, bundle identity, and cross-file invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "suite_version",
    "foundation_sha",
    "task_count",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "suite_id": {
      "$ref": "#/$defs/identity"
    },
    "suite_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "foundation_sha": {
      "$ref": "#/$defs/sha"
    },
    "task_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskEntry"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,127})$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifestPath": {
      "type": "string",
      "minLength": 12,
      "maxLength": 240,
      "pattern": "^tasks/(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f])(?!\\.[gG][iI][tT](?:/|$))(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.[gG][iI][tT](?:/|$)))(?!.*(?:/\\.{1,2}(?:/|$)))(?!.*[\\\\*?\\[\\]{}])[^/]+(?:/[^/]+)*\\.json$"
    },
    "fixtureRoot": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240,
      "pattern": "^fixtures/(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f])(?!\\.[gG][iI][tT](?:/|$))(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.[gG][iI][tT](?:/|$)))(?!.*(?:/\\.{1,2}(?:/|$)))(?!.*[\\\\*?\\[\\]{}])[^/]+(?:/[^/]+)*$"
    },
    "graderRoot": {
      "type": "string",
      "minLength": 9,
      "maxLength": 240,
      "pattern": "^graders/(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f])(?!\\.[gG][iI][tT](?:/|$))(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.[gG][iI][tT](?:/|$)))(?!.*(?:/\\.{1,2}(?:/|$)))(?!.*[\\\\*?\\[\\]{}])[^/]+(?:/[^/]+)*$"
    },
    "taskEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_version",
        "manifest_path",
        "manifest_sha256",
        "fixture_root",
        "grader_root"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/identity"
        },
        "task_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "manifest_path": {
          "$ref": "#/$defs/manifestPath"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "fixture_root": {
          "$ref": "#/$defs/fixtureRoot"
        },
        "grader_root": {
          "$ref": "#/$defs/graderRoot"
        }
      }
    }
  }
}
